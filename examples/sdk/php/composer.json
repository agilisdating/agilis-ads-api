{
    "name": "agilisdating/sdk-examples-php",
    "description": "Checks that the PHP SDK examples from the API reference compile against the SDK.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "agilisdating/agilis-ads": "dev-main",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/agilisdating/agilis-ads-php" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": { "php-http/discovery": true }
    }
}
